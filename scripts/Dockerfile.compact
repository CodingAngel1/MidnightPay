# Official Compact toolchain in a container.
#
# Midnight ships no native Windows build of `compact`, so on Windows the
# project compiles through this image instead (see scripts/compile.mjs).
# Linux/macOS contributors use the native compiler and never touch this file.
#
#   docker build -t midnight-compact -f scripts/Dockerfile.compact .
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates xz-utils unzip zip tar gzip git openssh-client \
 && rm -rf /var/lib/apt/lists/*

# Same installer the docs recommend, just the Linux x86_64 musl build.
RUN curl --proto '=https' --tlsv1.2 -LsSf https://github.com/midnightntwrk/compact/releases/latest/download/compact-installer.sh | sh

ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /work

CMD ["compact", "--help"]
